{
  "name": "homevault-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:local": "vite --mode local-api",
    "stop:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-vite.ps1",
    "start": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/caddy.ps1 start --config Caddyfile --adapter caddyfile",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/caddy.ps1 stop",
    "restart": "npm run stop && npm run start",
    "status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/status.ps1",
    "build": "tsc -b && vite build --mode production",
    "build:local": "tsc -b && vite build --mode local-api",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve:lan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/caddy.ps1 run --config Caddyfile --adapter caddyfile"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
